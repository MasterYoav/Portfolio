---
import Base from '@/layouts/Base.astro';
---

<Base title="Not found">
  <section class="py-32 text-center">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-4 text-[clamp(2.2rem,6vw,3.4rem)] leading-tight">This page wandered off.</h1>
    <p class="mt-4 text-lg text-muted-foreground">Try the <a class="ink-link text-foreground" href="/posts">writing</a>, the <a class="ink-link text-foreground" href="/projects">projects</a>, or press <kbd class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">/</kbd> to search.</p>
  </section>
</Base>
