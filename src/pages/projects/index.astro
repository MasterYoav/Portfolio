---
import Base from '@/layouts/Base.astro';
import { projects } from '@/data/site';
---

<Base title="Projects" description="Apps, utilities and games I've built and shipped.">
  <header class="pt-16 pb-10 sm:pt-20">
    <h1 class="rise text-[clamp(2.2rem,6vw,3.4rem)] leading-tight">Projects</h1>
    <p class="rise mt-3 max-w-[55ch] text-lg text-muted-foreground" style="--i:1">
      Everything here is real and runs on real machines. Open one for downloads, source and its story.
    </p>
  </header>

  <ul class="border-t border-border">
    {projects.map((p, i) => (
      <li class="rise border-b border-border" style={`--i:${i + 2}`}>
        <a href={`/projects/${p.id}`} class="group relative -mx-3 flex gap-5 overflow-hidden rounded-xl px-3 py-7 sm:gap-7" style={`--accent:${p.accent}`}>
          <span aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 size-56 rounded-full bg-(--accent) opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-[0.13]"></span>
          <img src={p.icon} alt="" width="72" height="72" loading="lazy" class="relative size-14 shrink-0 rounded-[22%] object-cover shadow-[0_10px_30px_-12px_var(--accent)] transition-transform duration-700 ease-(--ease-out-expo) group-hover:-translate-y-1 group-hover:-rotate-3 sm:size-[72px]" transition:name={`project-icon-${p.id}`} />
          <span class="relative min-w-0 flex-1">
            <span class="flex flex-wrap items-baseline justify-between gap-x-4">
              <span class="text-2xl">{p.name}</span>
              <span class="font-mono text-xs text-muted-foreground">{p.platform}</span>
            </span>
            <span class="mt-1 block text-sm text-muted-foreground">{p.category}</span>
            <span class="mt-3 block max-w-[60ch]">{p.blurb}</span>
            <span class="mt-4 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
              {p.stack.map((s) => <span>{s}</span>)}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
