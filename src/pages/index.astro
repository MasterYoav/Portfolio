---
import { projects } from '../lib/projects';

const contacts = [
  { label: 'GitHub', href: 'https://github.com/masteryoav' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/yoav-peretz-320056376/' },
  { label: 'Email', href: 'mailto:realyoavperetz@gmail.com' },
];

const apps = projects.map((project) => ({
  ...project,
  platform: project.platforms.join(' · '),
  blurb: project.summary,
  downloadUrl: project.releaseUrl,
}));

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Yoav Peretz builds focused apps, utilities, and developer tools."
    />
    <title>Yoav Peretz</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href="#home">YP</a>

        <nav class="contact-nav" aria-label="Contact links">
          {contacts.map((item) => (
            <a href={item.href} class="contact-chip" target="_blank" rel="noreferrer">
              {item.label}
            </a>
          ))}
        </nav>
      </header>

      <main id="home" class="hero-wrap">
        <section class="hero-card">
          <p class="eyebrow">Software engineer</p>
          <h1>
            Building sharp,
            <span>clean applications.</span>
          </h1>
          <p class="hero-copy">
            I design and build focused products with a minimal interface, smooth motion,
            and strong attention to detail.
          </p>

          <div class="hero-actions">
            <a class="primary-btn" href="#work">See work</a>
            <a class="secondary-btn" href="mailto:realyoavperetz@gmail.com">Contact me</a>
          </div>
        </section>
      </main>

      <section id="work" class="projects-section">
        <div class="projects-intro">
          <div>
            <p class="card-label">my projects</p>
          </div>
        </div>

        <div class="storefront-panel">
          <div class="storefront-meta">

          </div>

          <div class="app-shelf" role="list" aria-label="Project applications">
            {apps.map((app) => (
              <button
                type="button"
                class="app-tile"
                data-app-id={app.id}
                data-app-name={app.name}
                data-app-category={app.category}
                data-app-platform={app.platform}
                data-app-blurb={app.blurb}
                data-app-icon={app.icon}
                data-app-repo-url={app.repoUrl}
                data-app-download-url={app.downloadUrl}
                data-app-readme-url={app.readmeUrl}
                data-app-raw-base-url={app.rawBaseUrl}
                data-app-blob-base-url={app.blobBaseUrl}
                style={`--app-accent: ${app.accent}`}
                aria-haspopup="dialog"
                aria-label={`Open ${app.name}`}
              >
                <span class="app-icon-frame">
                  <img src={app.icon} alt="" loading="lazy" />
                </span>
                <span class="app-name">{app.name}</span>
                <span class="app-category">{app.category}</span>
              </button>
            ))}
          </div>
        </div>
      </section>
    </div>

    <dialog id="app-dialog" class="app-dialog" aria-labelledby="app-dialog-title">
      <div class="dialog-shell">
        <header class="dialog-header">
          <div class="dialog-app">
            <span class="dialog-icon-frame">
              <img id="app-dialog-icon" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'%3E%3Crect width='96' height='96' rx='24' fill='%23111111'/%3E%3Ctext x='48' y='61' fill='white' font-family='system-ui' font-size='30' font-weight='700' text-anchor='middle'%3EYP%3C/text%3E%3C/svg%3E" alt="" />
            </span>

            <div class="dialog-copy">
              <p class="card-label" id="app-dialog-label">project</p>
              <h3 id="app-dialog-title">App</h3>
              <p class="dialog-platform" id="app-dialog-platform"></p>
            </div>
          </div>

          <div class="dialog-actions">
            <div class="platform-downloads" id="app-dialog-platform-downloads" aria-label="Platform downloads" hidden></div>

            <button type="button" class="dialog-close" id="app-dialog-close" aria-label="Close">
              Close
            </button>
          </div>
        </header>

        <p class="dialog-blurb" id="app-dialog-blurb"></p>

        <section class="readme-shell" aria-live="polite">
          <div class="readme-status" id="app-dialog-status">Loading README…</div>
          <div class="readme-prose" id="app-dialog-readme" hidden></div>
        </section>
      </div>
    </dialog>

    <script>
      import { marked } from 'marked';
      import DOMPurify from 'dompurify';

      const dialog = document.getElementById('app-dialog');
      const appShelf = document.querySelector('.app-shelf');
      const supportsNativeDialog =
        typeof HTMLDialogElement !== 'undefined' && dialog instanceof HTMLDialogElement;

      if (!(dialog instanceof HTMLElement)) {
        throw new Error('App dialog is missing.');
      }

      const dialogIcon = document.getElementById('app-dialog-icon');
      const dialogLabel = document.getElementById('app-dialog-label');
      const dialogTitle = document.getElementById('app-dialog-title');
      const dialogPlatform = document.getElementById('app-dialog-platform');
      const dialogBlurb = document.getElementById('app-dialog-blurb');
      const platformDownloads = document.getElementById('app-dialog-platform-downloads');
      const dialogStatus = document.getElementById('app-dialog-status');
      const dialogReadme = document.getElementById('app-dialog-readme');
      const dialogClose = document.getElementById('app-dialog-close');
      const readmeShell = document.querySelector('.readme-shell');
      const readmeCache = new Map();
      const releaseCache = new Map();
      let scrollIndicatorTimer = 0;
      let platformDownloadToken = 0;
      let activeApp = null;
      const appStore = Array.from(document.querySelectorAll('.app-tile')).map((button) => ({
        id: button.dataset.appId ?? '',
        name: button.dataset.appName ?? '',
        category: button.dataset.appCategory ?? '',
        platform: button.dataset.appPlatform ?? '',
        blurb: button.dataset.appBlurb ?? '',
        icon: button.dataset.appIcon ?? '',
        repoUrl: button.dataset.appRepoUrl ?? '',
        downloadUrl: button.dataset.appDownloadUrl ?? '',
        readmeUrl: button.dataset.appReadmeUrl ?? '',
        rawBaseUrl: button.dataset.appRawBaseUrl ?? '',
        blobBaseUrl: button.dataset.appBlobBaseUrl ?? '',
      }));

      marked.setOptions({
        gfm: true,
        breaks: false,
      });

      const isExternalUrl = (value) =>
        /^(https?:|mailto:|tel:|data:|#)/i.test(value) || value.startsWith('//');
      const installableAssetPattern =
        /\.(dmg|pkg|exe|msi|deb|appimage|rpm|flatpak|snap|run)$/i;
      const platformPriority = { apple: 0, windows: 1, linux: 2 };

      const repoPathFromUrl = (repoUrl) => {
        const match = repoUrl.match(/github\.com\/([^/]+\/[^/]+?)(?:\.git|\/|$)/i);
        return match?.[1] ?? '';
      };

      const formatReleaseDate = (value) => {
        if (!value) return '';

        return new Intl.DateTimeFormat('en', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        }).format(new Date(value));
      };

      const classifyAssetPlatform = (name) => {
        const extension = name.split('.').pop()?.toLowerCase() ?? '';
        if (extension === 'dmg' || extension === 'pkg') {
          return 'apple';
        }
        if (extension === 'exe' || extension === 'msi') {
          return 'windows';
        }
        return 'linux';
      };

      const labelAssetPlatform = (platform) => {
        if (platform === 'apple') return 'macOS';
        if (platform === 'windows') return 'Windows';
        return 'Linux';
      };

      const iconAssetPlatform = (platform) => {
        if (platform === 'apple') return '/download-icons/apple-logo.png';
        if (platform === 'windows') return '/download-icons/windows.png';
        return '/download-icons/linux.png';
      };

      const isInstallableAsset = (asset) =>
        installableAssetPattern.test(asset.name || '') && asset.state === 'uploaded';

      const loadReleaseMenu = async (app) => {
        if (!app.repoUrl) {
          return [];
        }

        const cached = releaseCache.get(app.id);
        if (cached) {
          return cached;
        }

        const repoPath = repoPathFromUrl(app.repoUrl);
        if (!repoPath) {
          return [];
        }

        const response = await fetch(`https://api.github.com/repos/${repoPath}/releases?per_page=8`);
        if (!response.ok) {
          throw new Error(`Failed to load releases for ${repoPath}`);
        }

        const releases = await response.json();
        const installableReleases = releases
          .map((release) => ({
            title: release.tag_name || release.name || 'Release',
            date: formatReleaseDate(release.published_at),
            assets: (release.assets || [])
              .filter(isInstallableAsset)
              .map((asset) => {
                const platform = classifyAssetPlatform(asset.name || '');
                return {
                  platform,
                  platformLabel: labelAssetPlatform(platform),
                  icon: iconAssetPlatform(platform),
                  extension: asset.name.split('.').pop()?.toUpperCase() ?? 'FILE',
                  url: asset.browser_download_url,
                };
              })
              .sort((left, right) => platformPriority[left.platform] - platformPriority[right.platform]),
          }))
          .filter((release) => release.assets.length > 0);

        releaseCache.set(app.id, installableReleases);
        return installableReleases;
      };

      const latestPlatformAssets = (releases) => {
        const latest = { apple: null, windows: null, linux: null };

        for (const release of releases) {
          for (const asset of release.assets) {
            if (!latest[asset.platform]) {
              latest[asset.platform] = asset;
            }
          }

          if (latest.apple && latest.windows && latest.linux) {
            break;
          }
        }

        return latest;
      };

      const resetPlatformDownloads = () => {
        if (!(platformDownloads instanceof HTMLElement)) return;
        platformDownloads.innerHTML = '';
        platformDownloads.hidden = true;
      };

      const renderPlatformDownloads = (latestAssetsByPlatform) => {
        if (!(platformDownloads instanceof HTMLElement)) return;

        const platformOrder = ['apple', 'windows', 'linux'];
        const buttons = platformOrder
          .map((platform) => {
            const asset = latestAssetsByPlatform[platform];
            if (!asset?.url) {
              return '';
            }

            const platformLabel = labelAssetPlatform(platform);
            return `
              <a
                class="platform-download"
                data-platform="${platform}"
                href="${asset.url}"
                target="_blank"
                rel="noreferrer"
                aria-label="Download latest ${platformLabel} build"
                title="Download latest ${platformLabel} build"
              >
                <img src="${asset.icon}" alt="" width="64" height="64" />
              </a>
            `;
          })
          .filter(Boolean)
          .join('');

        platformDownloads.innerHTML = buttons;
        platformDownloads.hidden = buttons.length === 0;
      };

      const syncPlatformDownloads = async (app) => {
        const syncId = ++platformDownloadToken;

        resetPlatformDownloads();

        if (!app.repoUrl) {
          return;
        }

        try {
          const releases = await loadReleaseMenu(app);
          if (syncId !== platformDownloadToken || activeApp?.id !== app.id) {
            return;
          }

          const latestAssetsByPlatform = latestPlatformAssets(releases);
          renderPlatformDownloads(latestAssetsByPlatform);
        } catch {
          if (syncId !== platformDownloadToken || activeApp?.id !== app.id) {
            return;
          }

          resetPlatformDownloads();
        }
      };

      const resolveRepoAsset = (value, app, target) => {
        if (!value || isExternalUrl(value)) {
          return value;
        }

        if (value.startsWith('/')) {
          return app.repoUrl;
        }

        const normalized = value.replace(/^\.\//, '');
        return `${target === 'image' ? app.rawBaseUrl : app.blobBaseUrl}${normalized}`;
      };

      const rewriteReadmeNodes = (root, app) => {
        root.querySelectorAll('img').forEach((image) => {
          const source = image.getAttribute('src');
          if (source) {
            image.src = resolveRepoAsset(source, app, 'image');
            image.loading = 'lazy';
            image.decoding = 'async';
          }

          image.dataset.readmeWidth = image.getAttribute('width') ?? '';
          image.dataset.readmeHeight = image.getAttribute('height') ?? '';
          image.removeAttribute('width');
          image.removeAttribute('height');
        });

        root.querySelectorAll('a').forEach((anchor) => {
          const href = anchor.getAttribute('href');
          if (href) {
            anchor.href = resolveRepoAsset(href, app, 'link');
            anchor.target = '_blank';
            anchor.rel = 'noreferrer';
          }
        });
      };

      const renderReadme = (markdown, app) => {
        const rendered = marked.parse(markdown);
        const safeHtml = DOMPurify.sanitize(rendered, {
          USE_PROFILES: { html: true },
        });

        const template = document.createElement('template');
        template.innerHTML = safeHtml;
        rewriteReadmeNodes(template.content, app);
        return template.innerHTML;
      };

      const syncDialog = (app) => {
        if (!(dialogIcon instanceof HTMLImageElement)) return;

        activeApp = app;
        dialogIcon.src = app.icon;
        dialogIcon.alt = `${app.name} icon`;
        dialogLabel.textContent = app.category;
        dialogTitle.textContent = app.name;
        dialogPlatform.textContent = app.platform;
        dialogBlurb.textContent = app.blurb;
        resetPlatformDownloads();
      };

      const showReadmeMessage = (message) => {
        dialogStatus.hidden = false;
        dialogStatus.textContent = message;
        dialogReadme.hidden = true;
        dialogReadme.innerHTML = '';
      };

      const showReadmeHtml = (html) => {
        dialogStatus.hidden = true;
        dialogReadme.hidden = false;
        dialogReadme.innerHTML = html;
        fitReadmeImages();
      };

      const fitReadmeImages = () => {
        if (!(dialogReadme instanceof HTMLElement)) return;

        const viewportWidth = readmeShell instanceof HTMLElement ? readmeShell.clientWidth : dialogReadme.clientWidth;
        const availableWidth = Math.max(220, viewportWidth - 44);

        dialogReadme.querySelectorAll('img').forEach((image) => {
          if (!(image instanceof HTMLImageElement)) return;

          const declaredWidth = Number(image.dataset.readmeWidth || 0);
          const declaredHeight = Number(image.dataset.readmeHeight || 0);

          const applyLayout = () => {
            const naturalWidth = image.naturalWidth || declaredWidth || availableWidth;
            const naturalHeight = image.naturalHeight || declaredHeight || Math.max(1, Math.round(naturalWidth / 1.6));
            const aspectRatio = naturalWidth / naturalHeight;
            const imageUrl = image.currentSrc || image.src || '';
            const isBadgeHost =
              /shields\.io|badge\.svg|custom-icon-badges\.demolab\.com/i.test(imageUrl);
            const isBadgeSize = naturalHeight <= 24 || (naturalHeight <= 32 && naturalWidth <= 220);
            const isBadge = isBadgeHost || isBadgeSize;
            const isCentered =
              image.parentElement?.getAttribute('align') === 'center' ||
              image.closest('p[align="center"]') !== null;
            const isBanner =
              !isBadge &&
              (aspectRatio >= 2 ||
              /banner/i.test(image.alt) ||
              (isCentered && aspectRatio > 1.55));
            const paragraph = image.closest('p');
            const anchor = image.closest('a');

            image.classList.toggle('readme-image-badge', isBadge);
            paragraph?.classList.toggle('readme-badge-row', isBadge);
            anchor?.classList.toggle('readme-badge-link', isBadge);

            image.classList.toggle('readme-image-banner', isBanner);
            image.classList.toggle('readme-image-portrait', aspectRatio <= 0.8);

            if (isBadge) {
              image.style.width = 'auto';
              image.style.maxWidth = 'none';
              image.style.maxHeight = 'none';
              return;
            }

            if (isBanner) {
              const targetWidth = Math.min(availableWidth, naturalWidth, 860);
              const targetHeight = Math.min(260, Math.max(110, Math.round(targetWidth / aspectRatio)));
              image.style.width = '100%';
              image.style.maxWidth = `${targetWidth}px`;
              image.style.maxHeight = `${targetHeight}px`;
              return;
            }

            if (aspectRatio <= 0.8) {
              image.style.width = 'auto';
              image.style.maxWidth = `${Math.min(availableWidth, 420)}px`;
              image.style.maxHeight = `${Math.min(480, naturalHeight)}px`;
              return;
            }

            const targetWidth = Math.min(availableWidth, naturalWidth, 760);
            const targetHeight = Math.min(420, Math.max(140, Math.round(targetWidth / aspectRatio)));
            image.style.width = '100%';
            image.style.maxWidth = `${targetWidth}px`;
            image.style.maxHeight = `${targetHeight}px`;
          };

          applyLayout();
          if (!image.complete) {
            image.addEventListener('load', applyLayout, { once: true });
          }
        });
      };

      const showDialog = () => {
        if (supportsNativeDialog) {
          if (!dialog.open) {
            dialog.showModal();
          }
        } else {
          dialog.setAttribute('open', '');
        }

        document.body.classList.add('dialog-open');
      };

      const hideDialog = () => {
        if (supportsNativeDialog) {
          if (dialog.open) {
            dialog.close();
          }
        } else {
          dialog.removeAttribute('open');
        }

        document.body.classList.remove('dialog-open');
        if (readmeShell instanceof HTMLElement) {
          readmeShell.classList.remove('is-scrolling');
        }
        hideReleaseMenu();
      };

      const pulseReadmeScrollbar = () => {
        if (!(readmeShell instanceof HTMLElement)) return;

        readmeShell.classList.add('is-scrolling');
        window.clearTimeout(scrollIndicatorTimer);
        scrollIndicatorTimer = window.setTimeout(() => {
          readmeShell.classList.remove('is-scrolling');
        }, 1000);
      };

      const loadReadme = async (app) => {
        const cached = readmeCache.get(app.id);
        if (cached) {
          showReadmeHtml(cached);
          return;
        }

        showReadmeMessage('Loading README from GitHub…');

        try {
          const response = await fetch(app.readmeUrl);
          if (!response.ok) {
            throw new Error(`Failed to fetch ${app.readmeUrl}`);
          }

          const markdown = await response.text();
          const html = renderReadme(markdown, app);
          readmeCache.set(app.id, html);
          showReadmeHtml(html);
        } catch {
          showReadmeMessage('Could not load the README from GitHub right now.');
        }
      };

      const openApp = (appId) => {
        const app = appStore.find((entry) => entry.id === appId);
        if (!app) return;

        syncDialog(app);
        showDialog();
        loadReadme(app);
        void syncPlatformDownloads(app);
      };

      appShelf?.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const button = target.closest('.app-tile');
        if (!(button instanceof HTMLElement)) return;
        openApp(button.dataset.appId);
      });

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          hideDialog();
        }
      });

      if (supportsNativeDialog) {
        dialog.addEventListener('close', () => {
          document.body.classList.remove('dialog-open');
        });
      }

      dialogClose?.addEventListener('click', () => hideDialog());
      readmeShell?.addEventListener('scroll', pulseReadmeScrollbar, { passive: true });
      window.addEventListener('resize', fitReadmeImages);
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #050505;
    --panel: rgba(255, 255, 255, 0.03);
    --panel-strong: rgba(255, 255, 255, 0.05);
    --line: rgba(255, 255, 255, 0.09);
    --text: rgba(255, 255, 255, 0.94);
    --muted: rgba(255, 255, 255, 0.58);
    --soft: rgba(255, 255, 255, 0.72);
    --glow: rgba(255, 255, 255, 0.08);
    --shadow: 0 20px 80px rgba(0, 0, 0, 0.45);
    --radius-xl: 32px;
    --radius-lg: 18px;
    --radius-sm: 999px;
    --container: 1180px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.08), transparent 28%),
      radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.05), transparent 24%),
      linear-gradient(180deg, #080808 0%, #050505 100%);
    color: var(--text);
    font-family:
      'JetBrainsMono Nerd Font',
      'JetBrains Mono',
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      'Liberation Mono',
      monospace;
  }

  body.dialog-open {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    color: inherit;
    font: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .page-shell {
    width: min(calc(100% - 32px), var(--container));
    margin: 0 auto;
    padding: 20px 0 48px;
  }

  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: 14px 16px;
    background: rgba(10, 10, 10, 0.72);
    border: 1px solid var(--line);
    border-radius: 999px;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: var(--shadow);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: var(--panel-strong);
    border: 1px solid var(--line);
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .contact-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
  }

  .contact-chip {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--soft);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .contact-chip:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
  }

  .hero-wrap {
    min-height: calc(100vh - 120px);
    display: grid;
    align-items: center;
    padding: 28px 0 16px;
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 56px);
    border-radius: var(--radius-xl);
    border: 1px solid var(--line);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02)),
      rgba(255, 255, 255, 0.02);
    box-shadow: var(--shadow);
  }

  .hero-card::after {
    content: '';
    position: absolute;
    inset: auto -10% -20% auto;
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, var(--glow) 0%, transparent 68%);
    pointer-events: none;
  }

  .eyebrow,
  .card-label {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 10ch;
    margin-top: 18px;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
  }

  h1 span {
    color: rgba(255, 255, 255, 0.68);
  }

  .hero-copy {
    max-width: 640px;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.08rem);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .primary-btn,
  .secondary-btn {
