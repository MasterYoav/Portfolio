---
import Base from '@/layouts/Base.astro';
import { EncryptedText } from '@/components/EncryptedText';
import { ProjectDock } from '@/components/ProjectDock';
import { links, projects } from '@/data/site';
import { getPosts, formatDate, minutesToRead } from '@/lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base>
  <section class="pt-16 pb-14 sm:pt-24 sm:pb-20">
    <h1 class="rise text-[clamp(2.1rem,6vw,3.6rem)] leading-[1.08] tracking-[-0.02em]" style="--i:1">
      <EncryptedText client:load text="I ship software you can download," word="software" wordClassName="font-swash" revealDelayMs={22} flipDelayMs={40} />
      <span class="text-muted-foreground"> then write down how it was made.</span>
    </h1>

    <p class="rise mt-7 max-w-[60ch] text-lg text-muted-foreground" style="--i:2">
      Lately: a Mac app that gives AI agents their own computers, a notch that steers Claude Code, and a sea companion for
      iPhone and Apple Watch. This is where I keep the build notes, the release stories, and the apps themselves.
    </p>

    <ul class="rise mt-8 flex flex-wrap gap-x-6 gap-y-2" style="--i:3">
      {links.map((l) => (
        <li>
          <a href={l.href} class="ink-link group inline-flex items-center gap-1" target={l.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
            {l.label}
            <span aria-hidden="true" class="inline-block text-muted-foreground transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="writing" class="border-t border-border pt-10">
    <div class="flex items-baseline justify-between">
      <h2 id="writing" class="text-2xl">Latest writing</h2>
      <a href="/posts" class="ink-link text-sm text-muted-foreground hover:text-foreground">All {posts.length} posts →</a>
    </div>

    <ol class="mt-6">
      {latest.map((post, i) => (
        <li class="rise" style={`--i:${i + 4}`}>
          <a href={`/posts/${post.id}`} class="group -mx-3 grid gap-x-6 rounded-xl px-3 py-4 transition-colors hover:bg-card sm:grid-cols-[6.5rem_1fr]">
            <time datetime={post.data.date.toISOString()} class="font-mono text-xs leading-7 text-muted-foreground">
              {formatDate(post.data.date)}
            </time>
            <div>
              <h3 class="text-xl leading-snug" transition:name={`post-title-${post.id}`}>
                {post.data.title}
              </h3>
              <p class="mt-1.5 line-clamp-2 text-muted-foreground">{post.data.description}</p>
              <p class="mt-2 flex items-center gap-3 font-mono text-xs text-muted-foreground">
                <span>{minutesToRead(post)} min read</span>
                <span class="text-signal opacity-0 transition-[opacity,transform] duration-300 -translate-x-1 group-hover:translate-x-0 group-hover:opacity-100" aria-hidden="true">read →</span>
              </p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="shipped" class="mt-14 border-t border-border pt-10">
    <div class="flex items-baseline justify-between">
      <h2 id="shipped" class="text-2xl">What I build</h2>
      <a href="/projects" class="ink-link text-sm text-muted-foreground hover:text-foreground">All projects →</a>
    </div>
    <p class="mt-2 max-w-[55ch] text-muted-foreground">Each app opens its own page with downloads and the full README.</p>
    <div class="mt-8">
      <ProjectDock client:visible projects={projects.map(({ id, name, category, icon, accent }) => ({ id, name, category, icon, accent }))} />
    </div>
  </section>
</Base>
