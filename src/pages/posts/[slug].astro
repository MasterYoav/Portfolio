---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import { projects } from '@/data/site';
import { getPosts, formatDate, minutesToRead, type Post } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const project = projects.find((p) => p.id === post.data.project);
---

<Base title={post.data.title} description={post.data.description} backdrop>
  <div class="read-progress" aria-hidden="true"></div>

  <article class="pt-14 sm:pt-20">
    <header>
      <a href="/posts" class="ink-link rise font-mono text-xs text-muted-foreground hover:text-foreground">← all writing</a>
      <h1 class="mt-6 text-[clamp(2rem,5.5vw,3.2rem)] leading-[1.1] tracking-[-0.015em]" transition:name={`post-title-${post.id}`}>
        {post.data.title}
      </h1>
      <p class="rise mt-5 max-w-[60ch] text-lg text-muted-foreground" style="--i:1">{post.data.description}</p>
      <div class="rise mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-muted-foreground" style="--i:2">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'long')}</time>
        <span aria-hidden="true">·</span>
        <span>{minutesToRead(post)} min read</span>
        <span class="flex flex-wrap gap-1.5">
          {post.data.tags.map((t) => (
            <a href={`/posts?tag=${t}`} class={cn(badgeVariants({ variant: 'outline' }), 'font-mono font-normal text-muted-foreground transition-colors hover:border-signal hover:text-foreground')}>#{t}</a>
          ))}
        </span>
      </div>
    </header>

    <div class="relative mt-12 border-t border-border pt-10">
      {toc.length > 2 && (
        <nav aria-label="On this page" class="toc absolute top-10 -left-56 hidden w-44 xl:block">
          <div class="sticky top-24">
            <p class="font-mono text-xs text-muted-foreground">On this page</p>
            <ol class="mt-3 space-y-2 border-l border-border text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc={h.slug} class="-ml-px block border-l border-transparent pl-3 text-muted-foreground transition-colors duration-300 hover:text-foreground data-[active]:border-signal data-[active]:text-foreground">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}
      <div class="prose rise" style="--i:3">
        <Content />
      </div>
    </div>

    {project && (
      <a
        href={`/projects/${project.id}`}
        class="group mt-16 flex items-center gap-4 rounded-2xl border border-border p-4 transition-colors hover:bg-card"
        style={`--accent:${project.accent}`}
      >
        <img src={project.icon} alt="" width="56" height="56" class="size-14 rounded-[22%] object-cover shadow-[0_8px_24px_-8px_var(--accent)] transition-transform duration-500 ease-(--ease-out-expo) group-hover:-rotate-6 group-hover:scale-105" transition:name={`project-icon-${project.id}`} />
        <span class="flex-1">
          <span class="block text-lg">{project.name}</span>
          <span class="block text-sm text-muted-foreground">{project.gameUrl ? 'Play it in your browser' : 'Downloads, source and full README'}</span>
        </span>
        <span aria-hidden="true" class="text-muted-foreground transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    )}
  </article>

  <nav aria-label="More writing" class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
    {older ? (
      <a href={`/posts/${older.id}`} class="group rounded-xl p-3 -mx-3 transition-colors hover:bg-card">
        <span class="font-mono text-xs text-muted-foreground">← older</span>
        <span class="mt-1 block leading-snug">{older.data.title}</span>
      </a>
    ) : <span />}
    {newer && (
      <a href={`/posts/${newer.id}`} class="group -mx-3 rounded-xl p-3 text-right transition-colors hover:bg-card">
        <span class="font-mono text-xs text-muted-foreground">newer →</span>
        <span class="mt-1 block leading-snug">{newer.data.title}</span>
      </a>
    )}
  </nav>

  <script>
    // Highlight the section currently being read in the table of contents.
    document.addEventListener('astro:page-load', () => {
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
      if (!links.length) return;
      const headings = links.map((l) => document.getElementById(l.dataset.toc!)).filter(Boolean) as HTMLElement[];
      const observer = new IntersectionObserver(
        (entries) => {
          const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!hit) return;
          links.forEach((l) => l.toggleAttribute('data-active', l.dataset.toc === hit.target.id));
        },
        { rootMargin: '0px 0px -70% 0px' },
      );
      headings.forEach((h) => observer.observe(h));
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    });
  </script>
</Base>
